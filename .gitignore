# local oracle (pinned upstream clone + locally built C library) and venv
/reference/
/.venv/

# Python build artifacts; the editable install copies the cffi module in-tree
__pycache__/
*.py[cod]
*.so
*.o
*.a
/python/build/
/python/dist/
/python/*.egg-info/
/python/rsyscall/_raw*.c
/python/rsyscall/_nixdeps/

# tool caches and logs
.pytest_cache/
.mypy_cache/
*.log

# Rust native side: install prefix and cargo build directory; its venv
/native/prefix/
/native/target/
/.venv-rust/

# packaging: wheels, PEP 517 build tree, metadata, the wheel test venv, and the native
# artefacts that setup.py copies into the package in bundled mode
/dist/
/build/
*.egg-info/
/.venv-wheel/
/python/rsyscall/_native/librsyscall.so
/python/rsyscall/_native/rsyscall-*

# the HTML API reference built by `make docs` (published by the docs workflow)
/site/
